{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup (first time)",
      "type": "shell",
      "command": "${workspaceFolder}/setup.bat",
      "problemMatcher": []
    },
    {
      "label": "Backend",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe manage.py runserver 127.0.0.1:8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run all",
      "dependsOn": ["Backend", "Frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Create admin user",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe manage.py createsuperuser",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    }
  ]
}
