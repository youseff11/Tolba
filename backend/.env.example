# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- VisionSeek AI API (the FastAPI service) ---
# Put the current tunnel / server URL here, WITHOUT a trailing slash and WITHOUT /docs.
# Example: https://xxxx-xxxx.trycloudflare.com   or   http://127.0.0.1:8000
VISIONSEEK_BASE_URL=http://127.0.0.1:8000/mock
# Value of the X-API-Key header (leave empty if the AI server has no api_key.txt)
VISIONSEEK_API_KEY=
VISIONSEEK_TIMEOUT=60

# 1 = expose a fake VisionSeek API at /mock (for development when the real AI server is offline)
VISIONSEEK_MOCK=1
